<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>58eccf2c-1a2d-4fc8-bb92-00333bcbd184</UserSecretsId>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="NetCord" Version="1.0.0-beta.19" />
    <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.19" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.19" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-beta.19" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prevent trimming of NetCord assemblies -->
    <TrimmerRootAssembly Include="NetCord" />
    <TrimmerRootAssembly Include="NetCord.Services" />
    <TrimmerRootAssembly Include="NetCord.Hosting" />
    <TrimmerRootAssembly Include="NetCord.Hosting.Services" />

    <!-- Prevent trimming of your own bot project assembly -->
    <TrimmerRootAssembly Include="PigeonBotDotnet" />
  </ItemGroup>

</Project>
